{
  "schemaVersion": 8,
  "owner": "OPL Cloud",
  "purpose": "Portable product distribution and instance handoff boundary.",
  "state": "current",
  "machineBoundary": "Cloud promotes qualified digest-addressed Candidate bytes into portable product artifacts; the instance owner selects the provider and performs deployment.",
  "lifecycle": {
    "type": "long_term_contract",
    "removalCondition": "Replace only with a newer current contract for the same distribution and instance-handoff boundary."
  },
  "productRepository": "gaofeng21cn/one-person-lab-cloud",
  "candidate": {
    "workflow": ".github/workflows/build-opl-cloud-candidate.yml",
    "contract": "packages/contracts/opl-cloud-candidate-receipt-contract.json#candidateReceiptV2",
    "registry": "ghcr.io/gaofeng21cn/one-person-lab-cloud",
    "artifactLocator": {
      "kind": "github_actions_artifact",
      "exactKeys": [
        "workflowRunId",
        "workflowRunAttempt",
        "artifactName"
      ],
      "workflowRunIdField": "provenance.workflowRunId",
      "workflowRunAttemptField": "provenance.workflowRunAttempt",
      "artifactNameTemplate": "opl-cloud-candidate-{product.sha}-{provenance.workflowRunAttempt}",
      "artifactNameProductShaField": "product.sha",
      "artifactNameRunAttemptField": "provenance.workflowRunAttempt"
    },
    "formalPublication": false,
    "instanceDeployment": false
  },
  "distribution": {
    "workflow": ".github/workflows/release-opl-cloud-image.yml",
    "registry": "ghcr.io/gaofeng21cn/one-person-lab-cloud",
    "releaseTagFormat": "v0.x.y",
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ],
    "releaseAssets": {
      "$ref": "#/bundleFormats",
      "selection": "current release payload plus releaseManifest and checksumManifest"
    },
    "assetIntegrity": {
      "checksumManifest": "SHA256SUMS",
      "provenance": "github_oidc_custom_attestation",
      "predicateType": "https://github.com/gaofeng21cn/one-person-lab-cloud/attestations/opl-cloud-release/v1",
      "signerWorkflow": ".github/workflows/release-opl-cloud-image.yml"
    },
    "publication": {
      "promotionMode": "qualified_candidate_digest_without_rebuild",
      "requiredEvidence": {
        "candidate": [
          "candidate"
        ],
        "localInstallation": [
          "local_qualification"
        ],
        "instanceDeployment": [
          "instance_deployment_verified"
        ],
        "businessSourcePaths": [
          "business_source_paths_verified"
        ]
      },
      "instanceDeployment": {
        "owner": "gaofeng21cn/opl-instance-medopl",
        "workflow": ".github/workflows/deployment-verify.yml",
        "receiptStatus": "deployment_verified",
        "binds": [
          "receiptDigest",
          "candidateReceiptDigest",
          "productSha",
          "productTree",
          "cloudImageDigest"
        ]
      },
      "instanceEvidenceReader": {
        "secret": "OPL_GITHUB_RELEASE_ADMIN_TOKEN",
        "repository": "gaofeng21cn/opl-instance-medopl",
        "permissions": [
          "actions:read",
          "contents:read"
        ]
      },
      "serialization": {
        "concurrencyGroup": "opl-cloud-publication-global",
        "ownerJob": "publish",
        "unlockedJobs": [
          "admission"
        ]
      },
      "recovery": {
        "sameTagAssetReplacement": true,
        "versionBumpRequiredForPublicationFailure": false
      },
      "businessSourcePaths": {
        "owner": "gaofeng21cn/one-person-lab-cloud",
        "workflow": ".github/workflows/pull-request-ci.yml",
        "status": "source_verified",
        "paidBusinessExecuted": false,
        "customerReadsExecuted": false,
        "binds": [
          "productSha",
          "productTree",
          "ciRun",
          "entryPathHashes"
        ]
      },
      "automation": {
        "workflow": ".github/workflows/daily-release.yml",
        "protectedExecutionRef": "refs/heads/main",
        "sourceSelection": "immutable_product_tag_reachable_from_main",
        "reusesCandidateAndQualification": true,
        "instanceDeploymentDispatched": false,
        "missingQualificationStatus": "qualification_pending"
      }
    },
    "publicReadback": {
      "workflow": ".github/workflows/release-opl-cloud-public-readback.yml",
      "job": "public-readback",
      "trigger": "workflow_run",
      "manualRetryInput": "publication_run_id",
      "nonBlocking": true
    },
    "exactByteBinding": [
      "releaseTag",
      "productSha",
      "imageDigest",
      "releaseAssetSha256",
      "releaseAssetProvenance"
    ],
    "releaseManifestSchemaVersion": 4
  },
  "portableInstallation": {
    "entrypoint": "compose.cloud.yaml",
    "documentation": "docs/installation.md",
    "runtimeImagePolicy": "all_compose_images_require_registry_tag_and_sha256_digest",
    "processes": [
      "capability",
      "build",
      "runtime-control",
      "workspace",
      "serve",
      "resource-catalog",
      "ledger",
      "gateway-integration",
      "fabric",
      "control-plane",
      "console-bff"
    ],
    "persistence": "postgresql",
    "providerSelection": "instance_or_installer_owned",
    "workspaceProviderRequired": true,
    "composeScope": "owner_topology_processes_only",
    "ownerTopology": {
      "contract": "opl-cloud-owner-topology.json",
      "compose": "compose.cloud.yaml",
      "statement": "The published surface is the owner topology: the entrypoint Compose file runs exactly the processes the owner topology contract declares, and the owner topology contract itself is a Candidate-only asset."
    }
  },
  "instanceHandoff": {
    "repository": "gaofeng21cn/opl-instance-medopl",
    "contract": "packages/contracts/opl-cloud-candidate-receipt-contract.json#candidateReceiptV2",
    "artifactLocatorContract": "packages/contracts/opl-cloud-distribution-contract.json#candidate.artifactLocator",
    "inputs": [
      "candidate_manifest_b64"
    ]
  },
  "evidenceOwners": {
    "currentCapability": "docs/status.md",
    "activeGapsAndPriority": "docs/roadmap.md"
  },
  "bundleFormats": {
    "current": "portable-v1",
    "candidateSchemaVersion": 2,
    "releaseSchemaVersion": 4,
    "candidateOnlyAssets": [
      "opl-cloud-owner-topology.json"
    ],
    "candidateOnlyAssetsReason": "The owner topology contract is the Cloud-owned declaration the published surface is checked against. It stays in its Candidate bundle and is not an additional public Release asset.",
    "formats": {
      "legacy-v2": {
        "candidateAssets": [
          "compose.yaml",
          "compose.deployment-platform-owned.yaml",
          "compose.deployment-managed-tke.yaml",
          "compose.deployment-customer-owned.yaml",
          "compose.fabric-local-docker.yaml",
          "compose.fabric-tencent-tke.yaml",
          "compose.local-workspace.yaml",
          "opl-cloud.env.example",
          "opl-cloud-owner-topology.json"
        ],
        "releaseAssets": [
          "compose.yaml",
          "compose.deployment-platform-owned.yaml",
          "compose.deployment-managed-tke.yaml",
          "compose.deployment-customer-owned.yaml",
          "compose.fabric-local-docker.yaml",
          "compose.fabric-tencent-tke.yaml",
          "compose.local-workspace.yaml",
          "opl-cloud.env.example"
        ]
      },
      "portable-v1": {
        "candidateAssets": [
          "compose.yaml",
          "compose.deployment-platform-owned.yaml",
          "compose.deployment-managed-tke.yaml",
          "compose.deployment-customer-owned.yaml",
          "compose.fabric-local-docker.yaml",
          "compose.fabric-tencent-tke.yaml",
          "compose.local-workspace.yaml",
          "opl-cloud.env.example",
          "opl-cloud-owner-topology.json",
          "install.sh",
          "install.mjs",
          "installer-manifest.mjs",
          "compose.cloud.yaml",
          "compose.local-v2.yaml",
          "cloud-proxy.nginx.conf",
          "owner-databases.sh",
          "local-v2-pki.sh",
          "agent-plugins-1.0.0-plugin.schema.json",
          "opl-cloud-distribution-contract.json"
        ],
        "releaseAssets": [
          "compose.yaml",
          "compose.deployment-platform-owned.yaml",
          "compose.deployment-managed-tke.yaml",
          "compose.deployment-customer-owned.yaml",
          "compose.fabric-local-docker.yaml",
          "compose.fabric-tencent-tke.yaml",
          "compose.local-workspace.yaml",
          "opl-cloud.env.example",
          "install.sh",
          "install.mjs",
          "installer-manifest.mjs",
          "compose.cloud.yaml",
          "compose.local-v2.yaml",
          "cloud-proxy.nginx.conf",
          "owner-databases.sh",
          "local-v2-pki.sh",
          "agent-plugins-1.0.0-plugin.schema.json",
          "opl-cloud-distribution-contract.json"
        ]
      }
    },
    "assetSources": {
      "compose.yaml": "compose.yaml",
      "opl-cloud-distribution-contract.json": "packages/contracts/opl-cloud-distribution-contract.json"
    },
    "defaultAssetSourceDirectory": "deploy/portable",
    "candidateManifest": "opl-cloud-candidate.json",
    "releaseManifest": "opl-cloud-release.json",
    "checksumManifest": "SHA256SUMS",
    "selection": "exact_ordered_asset_names_no_subsets",
    "instanceEnvelope": "schema2_unchanged; asset format is selected by the exact ordered assets, not a new envelope schema"
  }
}
