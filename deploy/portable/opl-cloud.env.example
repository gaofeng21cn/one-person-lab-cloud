# Immutable image from the matching GitHub Release manifest.
OPL_CLOUD_IMAGE=ghcr.io/gaofeng21cn/one-person-lab-cloud@sha256:<64-hex-digest>

# Bind locally by default; put a TLS reverse proxy in front for remote access.
OPL_BIND_ADDRESS=127.0.0.1
OPL_HTTP_PORT=8787
OPL_PUBLIC_URL=http://localhost:8787
# The installer owns this Workspace hostname. Use a concrete host (without a
# path) for the selected installation; Cloud has no medopl hostname fallback.
# Every deployment mode requires it: the Control Plane refuses to start without
# it. It must be a different host from OPL_PUBLIC_URL because the Control Plane
# routes Workspace entries by host and serves the Console on every other host,
# so a single-host installation uses a Workspace subdomain such as ws.localhost.
OPL_WORKSPACE_DOMAIN=<replace-with-workspace-domain>
# Optional and deliberately independent of OPL_WORKSPACE_DOMAIN: the domain the
# per-binding application origins live under, exactly one label below the zone
# (<workspaceId>-<12 hex of stableID("workspace-application-origin", ...)>.<this domain>).
# Control Plane derives and dispatches the application host from it and Serve
# publishes the Agent's address from it; an installation that leaves it empty
# publishes no application origins and keeps the retained /w/<workspaceId>/
# path entry instead of an address that cannot resolve. It is not inferred from
# OPL_WORKSPACE_DOMAIN because which DNS record and certificate the installation
# must hold is its own installation fact.
OPL_WORKSPACE_APPLICATION_DOMAIN=

# Keep the PostgreSQL address inside this RFC1918 subnet. Change both values if
# the default network overlaps another Docker or host network.
OPL_DOCKER_SUBNET=172.30.0.0/24
OPL_POSTGRES_HOST=172.30.0.10
# Create this absolute customer-owned directory before starting Local-Docker.
OPL_POSTGRES_DATA_ROOT=/absolute/path/to/opl-cloud-data/postgres

# The bootstrap administrator stays inside PostgreSQL. Each service receives
# only its own database role through its own DATABASE_URL. These databases are
# created when PostgreSQL initializes a new volume; back up and explicitly
# migrate an existing shared database before switching this configuration.
# Use distinct long random hexadecimal values so URLs need no escaping.
OPL_POSTGRES_ADMIN_PASSWORD=<replace-with-long-random-hex>
OPL_CONTROL_PLANE_DATABASE_PASSWORD=<replace-with-different-long-random-hex>
OPL_FABRIC_DATABASE_PASSWORD=<replace-with-different-long-random-hex>
OPL_LEDGER_DATABASE_PASSWORD=<replace-with-different-long-random-hex>

# Generate five independent random values. Service and runner tokens are
# transport identities; the Fabric capability key signs short-lived requests.
OPL_CONTROL_PLANE_SERVICE_TOKEN=<replace-with-independent-control-plane-32-plus-random-chars>
OPL_FABRIC_SERVICE_TOKEN=<replace-with-independent-fabric-32-plus-random-chars>
OPL_LEDGER_SERVICE_TOKEN=<replace-with-independent-ledger-32-plus-random-chars>
OPL_FABRIC_RUNNER_SERVICE_TOKEN=<replace-with-independent-fabric-runner-32-plus-random-chars>
OPL_FABRIC_CAPABILITY_KEY=<replace-with-independent-fabric-capability-32-plus-random-chars>
OPL_LEDGER_CAPABILITY_KEY=<replace-with-independent-ledger-capability-32-plus-random-chars>
OPL_AIONUI_ADMIN_PASSWORD_SEED=<replace-with-32-plus-random-chars>

# Sub2API remains the only spendable-balance owner.
OPL_SUB2API_BASE_URL=https://your-sub2api.example.com
# platform_owned and managed_tke use this administrator identity as the
# Cloud operator. customer_owned uses the ordinary user identity below.
OPL_SUB2API_ADMIN_EMAIL=<replace-with-admin-email>
OPL_SUB2API_ADMIN_PASSWORD=<replace-with-admin-password>
# customer_owned never needs Sub2API administrator access.
OPL_SUB2API_USER_EMAIL=<replace-with-customer-user-email>
OPL_SUB2API_USER_PASSWORD=<replace-with-customer-user-password>
OPL_SUB2API_REQUEST_TIMEOUT_MS=5000

# The base Compose path keeps Workspace launches disabled. In the directory
# containing the downloaded release assets, copy this file to opl-cloud.env,
# replace every placeholder, and start Local-Docker with:
# Select exactly one deployment overlay and one Fabric overlay. The local
# workspace overlay supplies the customer-owned PostgreSQL bind and launch
# worker settings:
# docker compose --env-file ./opl-cloud.env -f ./compose.yaml \
#   -f ./compose.deployment-customer-owned.yaml \
#   -f ./compose.fabric-local-docker.yaml \
#   -f ./compose.local-workspace.yaml up -d
# The installer owns the Workspace image. Replace this with the exact immutable
# repository@sha256 reference selected for this installation.
OPL_WORKSPACE_IMAGE=<replace-with-workspace-repository@sha256:64-hex-digest>
# Managed TKE requires this protected catalog. OPL_WORKSPACE_IMAGE is the
# installation default and must appear exactly once in the catalog. Local
# Docker may leave the value empty and exposes only OPL_WORKSPACE_IMAGE.
OPL_WORKSPACE_IMAGE_RELEASES_JSON=
# Example: {"schemaVersion":1,"releases":[{"version":"26.8.26","image":"registry.example/opl/workspace@sha256:<64-hex-digest>"}]}
# Linux normally uses this default. Docker Desktop users should set the absolute
# socket path reported by their active context, for example /Users/<you>/.docker/run/docker.sock.
OPL_DOCKER_SOCKET_PATH=/var/run/docker.sock
# This exact container name is assigned to Control Plane and passed to Fabric.
# Change it when another deployment on the same Docker host already uses it.
OPL_FABRIC_LOCAL_DOCKER_GATEWAY_CONTAINER=opl-cloud-control-plane
# Runtime URLs use this deployment-reachable host when Docker publishes on a
# loopback or unspecified address. Set a LAN-reachable address when needed.
OPL_FABRIC_LOCAL_DOCKER_HOST=127.0.0.1
# Docker binds Workspace ports to this host independently of the Runtime URL.
OPL_FABRIC_LOCAL_DOCKER_PUBLISH_HOST=127.0.0.1
# The portable Local-Docker overlay uses OPL_CLOUD_IMAGE for isolated HTTP probes.
# Native Fabric runs that deploy applications with healthChecks must explicitly set
# OPL_FABRIC_LOCAL_DOCKER_PROBE_IMAGE to that same immutable Cloud image reference.
# Docker Desktop and WSL may report MemorySwap=-1 despite an exact memory limit.
# Set exactly 1 on those hosts; CPU and memory readback remain exact.
OPL_FABRIC_LOCAL_DOCKER_ALLOW_UNBOUNDED_SWAP=0
# Create this absolute customer-owned root on a dedicated Linux 5.14+ ext4/XFS
# filesystem with project quota enabled. Fabric owns that filesystem's project
# IDs and assigns one kernel-enforced quota per Workspace. Before upgrading from
# schema 1 directory storage, delete/recreate those Workspaces with the old
# release; legacy roots, unsupported filesystems, and Docker Desktop fail
# readiness/preflight instead of running without quota.
OPL_FABRIC_LOCAL_DOCKER_STORAGE_ROOT=/absolute/path/to/opl-workspaces
# Deployment-owned Local-Docker package profile. Tune CPU, memory and storage
# for this host; Fabric rejects startup when the profile is absent or invalid.
# The Local qualification entry (npm run qualify:local:workspace) reads the
# storage root and this profile from its own environment and stops with a named
# reason when either is absent, because it must qualify this host, not an
# invented one.
OPL_FABRIC_LOCAL_DOCKER_PROVIDER_PROFILE_JSON={"schemaVersion":1,"packages":[{"id":"basic","name":"Basic Workspace","available":true,"compute":{"id":"local-basic","server":"configured","cpu":2,"memoryGb":4,"instanceType":"local-basic"},"storage":{"sizeGb":10,"quotaPolicy":"linux-project"}},{"id":"pro","name":"Pro Workspace","available":true,"compute":{"id":"local-pro","server":"configured","cpu":8,"memoryGb":16,"instanceType":"local-pro"},"storage":{"sizeGb":100,"quotaPolicy":"linux-project"}}]}
# Create this absolute task-owned directory with mode 0700 before starting the
# local Workspace overlay. Fabric is the only owner of the Secret files inside.
OPL_FABRIC_LOCAL_DOCKER_SECRET_ROOT=/absolute/path/to/opl-fabric-secrets

OPL_MONTHLY_BILLING_WORKER_ENABLED=0
OPL_WORKSPACE_LAUNCH_WORKER_ENABLED=0
# Set to 1 to execute admitted application deployment intents and resume them.
# compose.local-workspace.yaml enables this with the local Workspace workers.
OPL_WORKSPACE_APPLICATION_DEPLOYMENT_WORKER_ENABLED=0
# platform_owned and managed_tke require an admin credential for resource billing.
# customer_owned uses the configured ordinary Sub2API account and never debits compute/storage.
OPL_DEPLOYMENT_MODE=customer_owned
# Fabric is an independent infrastructure choice. Local-Docker uses the
# customer's Docker Engine; tencent-tke uses the Tencent adapter instead.
OPL_FABRIC_PROVIDER=local-docker
# Required by compose.fabric-tencent-tke.yaml only, and required form: leave
# them populated when that provider is selected so Compose fails before startup
# on incomplete values. Fabric's Tencent provider validates the Workspace
# domain, the immutable Workspace image, the namespace and the provisioner
# binary when it builds the provider, and reports the remaining keys as missing
# from its own readiness, so this overlay forwards every one of them.
OPL_TENCENT_REGION=<replace-with-tencent-region>
OPL_TENCENT_ZONE=<replace-with-tencent-zone>
OPL_K8S_NAMESPACE=<replace-with-kubernetes-namespace>
OPL_TENCENT_PROVISIONER_BIN=<replace-with-absolute-provisioner-path>
OPL_IMAGE_PULL_SECRET_NAME=<replace-with-workspace-image-pull-secret>
# Required once a Tenant is admitted: the installation's personal-TCR namespace
# that Tenant application OCI destinations are reserved under. Both values are
# supplied together; they carry no credential. Build pushes with its own scoped
# credential and the runtime pulls with the image pull secret above.
OPL_WORKSPACE_REGISTRY_HOST=<replace-with-registry-host-without-scheme>
OPL_WORKSPACE_REGISTRY_NAMESPACE=<replace-with-registry-namespace>
# Optional explicit application IngressClass; otherwise Kubernetes admission
# and the installation's default controller select it. Readback still requires
# the actual controller address and exact application route.
OPL_INGRESS_CLASS=
OPL_WORKSPACE_STORAGE_CLASS=<replace-with-workspace-storage-class>
# Required whenever OPL_FABRIC_PROVIDER=tencent-tke. Fabric's protected-resource
# guard refuses every mutating kubectl action unless these identify the
# installation's own system node pool and machine, so a missing value fails
# before Fabric mutates provider or cluster state instead of risking the system
# node. Machine type is NativeCVM (with an ins- CVM id) or Native/CXM (with an
# empty id). They must name a node pool and machine that no Workspace package
# uses; the deployment-owned package profile above must not reference the system
# node pool. The same facts are validated by
# services/control-plane/ops/production-manifest.ts for a production TKE install.
OPL_SYSTEM_COMPUTE_NODE_POOL_ID=<replace-with-system-node-pool-id>
OPL_SYSTEM_COMPUTE_MACHINE_ID=<replace-with-system-machine-id>
OPL_SYSTEM_COMPUTE_NODE_NAME=<replace-with-system-node-name>
OPL_SYSTEM_COMPUTE_MACHINE_TYPE=<replace-with-NativeCVM-or-Native-or-CXM>
OPL_SYSTEM_COMPUTE_CVM_ID=<replace-with-system-cvm-id-or-empty>
# Fabric is the only process that holds the cluster credentials. The installer
# keeps the TKE deploy kubeconfig on the host and sets both values together:
# the absolute host path this base installation mounts, and the absolute
# in-container path Fabric is told to read. compose.fabric-tencent-tke.yaml
# mounts TENCENT_DEPLOY_KUBECONFIG_HOST_PATH read-only at
# TENCENT_DEPLOY_KUBECONFIG_REF. An Instance that supplies the kubeconfig as a
# Kubernetes Secret keeps the reference form instead.
TENCENT_DEPLOY_KUBECONFIG_HOST_PATH=<replace-with-absolute-host-kubeconfig-path>
TENCENT_DEPLOY_KUBECONFIG_REF=<replace-with-absolute-in-container-kubeconfig-path>
# Explicit live-mutation opt-in for the Tencent provisioner. Every non-dry-run
# provider mutation is refused unless this is 1, so 0 keeps an installation
# read-only and 1 authorizes real Tencent resource creation, renewal and
# deletion under the installation's own credentials and approved policy. It is
# not a default: the installer sets it deliberately.
RUN_TENCENT_CREATE_RELEASE_EXECUTION=0
# Explicit deployment-owned system disk for newly bootstrapped TKE NodePools.
# This is not a Workspace package specification and has no provider fallback.
TENCENT_CVM_SYSTEM_DISK_TYPE=<replace-with-cvm-system-disk-type>
TENCENT_CVM_SYSTEM_DISK_SIZE_GB=<replace-with-cvm-system-disk-size-gb>
# Explicit deployment-owned disk type for non-Workspace CBS operations such
# as Provider acceptance; Workspace storage uses the selected profile entry.
TENCENT_CBS_DISK_TYPE=<replace-with-cbs-disk-type>
# Deployment-owned Tencent/TKE package profile. Keep all CVM/TKE/CBS facts in
# this one profile; Fabric binds the selected package immutably at preflight.
OPL_FABRIC_TENCENT_TKE_PROVIDER_PROFILE_JSON={"schemaVersion":1,"packages":[{"id":"basic","name":"Basic Workspace","available":true,"compute":{"id":"pool-basic-2c4g","server":"2c4g","cpu":2,"memoryGb":4,"diskGb":10,"instanceType":"<replace-with-basic-cvm-instance-type>"},"nodePoolId":"<replace-with-basic-node-pool-id>","maxReplicas":20,"zone":"<replace-with-tencent-zone>","storage":{"sizeGb":10,"diskType":"<replace-with-cbs-disk-type>"},"billing":{"chargeType":"PREPAID","periodMonths":1,"renewFlag":"NOTIFY_AND_MANUAL_RENEW"}},{"id":"pro","name":"Pro Workspace","available":true,"compute":{"id":"pool-pro-8c16g","server":"8c16g","cpu":8,"memoryGb":16,"diskGb":100,"instanceType":"<replace-with-pro-cvm-instance-type>"},"nodePoolId":"<replace-with-pro-node-pool-id>","maxReplicas":20,"zone":"<replace-with-tencent-zone>","storage":{"sizeGb":100,"diskType":"<replace-with-cbs-disk-type>"},"billing":{"chargeType":"PREPAID","periodMonths":1,"renewFlag":"NOTIFY_AND_MANUAL_RENEW"}}]}

# ---------------------------------------------------------------------------
# Cloud owner topology (OPL_CLOUD_OWNER_TOPOLOGY=1)
#
# One product image carries every owner executable; the installation selects
# which processes to run. deploy/portable/opl-cloud-owner-topology.json is the
# Cloud-owned declaration of those processes, and
# tests/contracts/owner-topology.test.ts derives every name below from the
# owning Go source, so this list cannot drift from what the processes read.
#
# Naming: an owner process listens on OPL_<OWNER>_ADDR and admits callers
# through OPL_<OWNER>_PEER_TOKENS; a caller reaches it through OPL_<OWNER>_URL
# and OPL_<OWNER>_TOKEN. Both spellings for the same target must be set.
# Ledger and Resource Catalog both default to :8186, so every address below is
# set explicitly; two owners must never share a listen address.
OPL_CLOUD_OWNER_TOPOLOGY=1
# Production refuses to start an owner without a database and a peer allowlist.
NODE_ENV=production
DATABASE_URL=<per-process: this owner's own database URL>
OPL_GRPC_INSECURE_LOCAL=0
OPL_GRPC_CA_FILE=<absolute-in-container-CA-file-path>
OPL_GRPC_CERT_FILE=<absolute-in-container-service-certificate-path>
OPL_GRPC_KEY_FILE=<absolute-in-container-service-key-path>
OPL_CLOUD_IDENTITY_URL=<absolute-address-of-the-gateway-integration-owner>
OPL_CLOUD_IDENTITY_TOKEN=<replace-with-independent-cloud-identity-32-plus-random-chars>
OPL_CLOUD_IDENTITY_ADDR=<replace-with-gateway-integration-listen-address-for-the-installed-topology>

# Gateway Integration (owner identity "tenant": CloudIdentity + Gateway + TCR binding).
OPL_TENANT_ADDR=<replace-with-gateway-integration-listen-address>
OPL_TENANT_PEER_TOKENS={"console_bff":"<32-plus-random-chars>","workspace":"<32-plus-random-chars>","build":"<32-plus-random-chars>","fabric":"<32-plus-random-chars>"}
OPL_GATEWAY_DATABASE_URL=<replace-with-gateway-integration-database-url>
OPL_GATEWAY_URL=<replace-with-gateway-integration-address-for-callers>
OPL_GATEWAY_TOKEN=<replace-with-independent-gateway-32-plus-random-chars>
OPL_SUB2API_URL=<replace-with-sub2api-base-url>
OPL_SUB2API_SERVICE_TOKEN=<replace-with-independent-sub2api-service-32-plus-random-chars>
OPL_GATEWAY_WORKSPACE_KEY_GROUP=<replace-with-approved-gateway-workspace-key-group>
OPL_SESSION_SIGNING_KEY=<replace-with-32-plus-random-chars>
OPL_GATEWAY_DIRECTORY_EMAIL=<replace-with-gateway-directory-admin-email>
OPL_GATEWAY_DIRECTORY_PASSWORD=<replace-with-gateway-directory-admin-password>
OPL_INVITATION_TTL=<replace-with-invitation-ttl-duration>
OPL_PLATFORM_ADMIN_SUBJECTS=<replace-with-comma-separated-platform-admin-subjects>

# Capability (Package/WebUI/build-result catalog; object store).
OPL_CAPABILITY_ADDR=<replace-with-capability-listen-address>
OPL_CAPABILITY_PEER_TOKENS={"console_bff":"<32-plus-random-chars>","build":"<32-plus-random-chars>","runtime_control":"<32-plus-random-chars>","workspace":"<32-plus-random-chars>","serve":"<32-plus-random-chars>"}
OPL_CAPABILITY_URL=<replace-with-capability-address-for-callers>
OPL_CAPABILITY_TOKEN=<replace-with-independent-capability-32-plus-random-chars>
OPL_CAPABILITY_STORAGE_KIND=<replace-with-file-or-cos>
OPL_CAPABILITY_OBJECT_LISTEN_ADDR=<replace-with-capability-object-store-listen-address>
OPL_CAPABILITY_OBJECT_URL=<replace-with-capability-object-store-public-url>
OPL_CAPABILITY_OBJECT_ROOT=<replace-with-absolute-object-store-root-path>
OPL_CAPABILITY_OBJECT_TOKEN=<replace-with-independent-object-store-32-plus-random-chars>
OPL_CAPABILITY_OBJECT_SIGNING_KEY=<replace-with-independent-object-signing-32-plus-random-chars>
OPL_CAPABILITY_PACKAGE_SCHEMA_PATH=<absolute-in-container-package-schema-path>
OPL_CAPABILITY_PACKAGE_SCHEMA_DIGEST=<replace-with-package-schema-sha256>
OPL_PUBLISHER_SCHEMA_PATH=<absolute-in-container-publisher-contract-schema-path>
OPL_PUBLISHER_SCHEMA_DIGEST=<replace-with-publisher-contract-schema-sha256>
OPL_CAPABILITY_COS_ENDPOINT=<replace-with-cos-endpoint>
OPL_CAPABILITY_COS_REGION=<replace-with-cos-region>
OPL_CAPABILITY_COS_BUCKET=<replace-with-cos-bucket>
OPL_CAPABILITY_COS_SECRET_ID=<replace-with-cos-secret-id>
OPL_CAPABILITY_COS_SECRET_KEY=<replace-with-cos-secret-key>

# Build (admitted BuildKit execution).
OPL_BUILD_ADDR=<replace-with-build-listen-address>
OPL_BUILD_PEER_TOKENS={"capability":"<32-plus-random-chars>","console_bff":"<32-plus-random-chars>"}
OPL_BUILD_URL=<replace-with-build-address-for-callers>
OPL_BUILD_TOKEN=<replace-with-independent-build-32-plus-random-chars>
OPL_BUILD_BUILDER=<replace-with-buildkit-builder-name>
OPL_BUILD_WORKDIR=<replace-with-absolute-build-work-directory>
OPL_BUILD_DOCKER_CONFIG=<replace-with-absolute-docker-config-directory>
OPL_BUILD_REGISTRY_PREFIX=<replace-with-output-registry-prefix>
OPL_BUILD_REGISTRY_TOKEN=<replace-with-output-registry-token>

# Runtime Control (Runtime Release admission and immutable readback).
OPL_RUNTIME_CONTROL_ADDR=<replace-with-runtime-control-listen-address>
OPL_RUNTIME_CONTROL_PEER_TOKENS={"console_bff":"<32-plus-random-chars>","workspace":"<32-plus-random-chars>","capability":"<32-plus-random-chars>"}
OPL_RUNTIME_CONTROL_URL=<replace-with-runtime-control-address-for-callers>
OPL_RUNTIME_CONTROL_TOKEN=<replace-with-independent-runtime-control-32-plus-random-chars>
OPL_RUNTIME_PUBLISHER_SCHEMA_PATH=<absolute-in-container-runtime-publisher-schema-path>
OPL_RUNTIME_PUBLISHER_SCHEMA_DIGEST=<replace-with-runtime-publisher-schema-sha256>

# Resource Catalog (provider plans, price and policy versions).
OPL_RESOURCE_CATALOG_ADDR=<replace-with-resource-catalog-listen-address>
OPL_RESOURCE_CATALOG_PEER_TOKENS={"console_bff":"<32-plus-random-chars>","workspace":"<32-plus-random-chars>","ledger":"<32-plus-random-chars>"}
OPL_RESOURCE_CATALOG_URL=<replace-with-resource-catalog-address-for-callers>
OPL_RESOURCE_CATALOG_TOKEN=<replace-with-independent-resource-catalog-32-plus-random-chars>
OPL_RESOURCE_CATALOG_PROFILE_JSON=<replace-with-deployment-owned-provider-profile-json>

# Workspace (accepted order, entitlement and resource intent).
OPL_WORKSPACE_ADDR=<replace-with-workspace-listen-address>
OPL_WORKSPACE_PEER_TOKENS={"console_bff":"<32-plus-random-chars>","tenant":"<32-plus-random-chars>","ledger":"<32-plus-random-chars>"}
OPL_WORKSPACE_URL=<replace-with-workspace-address-for-callers>
OPL_WORKSPACE_TOKEN=<replace-with-independent-workspace-32-plus-random-chars>
OPL_SERVE_ADDR=<replace-with-serve-listen-address>
OPL_GATEWAY_ADDR=<replace-with-gateway-integration-listen-address-from-the-workspace-process>
OPL_LEDGER_ADDR=<replace-with-ledger-listen-address>

# Serve (sole writer of deployment, readiness and access facts).
# The application entry a customer's browser opens. Serve serves it itself on this
# declared address; the installation's stable Ingress forwards the Workspace
# application origins to it. It must differ from OPL_SERVE_ADDR, which carries
# Serve's owner surface.
OPL_SERVE_ACCESS_ADDR=<replace-with-serve-access-entry-listen-address>
OPL_SERVE_PEER_TOKENS={"console_bff":"<32-plus-random-chars>","workspace":"<32-plus-random-chars>","capability":"<32-plus-random-chars>"}
OPL_SERVE_URL=<replace-with-serve-address-for-callers>
OPL_SERVE_TOKEN=<replace-with-independent-serve-32-plus-random-chars>
OPL_FABRIC_COORDINATION_ADDR=<replace-with-fabric-coordination-listen-address>
OPL_FABRIC_COORDINATION_TOKEN=<replace-with-independent-fabric-coordination-32-plus-random-chars>

# Serve owns application execution, so a managed-TKE installation declares the
# namespace, kubeconfig Secret reference, image-pull Secret and the same
# protected-compute facts Fabric's provider is bounded by. An installation that
# declares no execution boundary leaves the capability absent, and the delivery
# step fails closed instead of borrowing another owner's cluster access.
OPL_K8S_NAMESPACE=<replace-with-kubernetes-namespace>
TENCENT_DEPLOY_KUBECONFIG_REF=<replace-with-serving-kubeconfig-path>
OPL_IMAGE_PULL_SECRET_NAME=<replace-with-registry-pull-secret-name>
# The pods allowed to reach a Workspace application: the Serve access data plane
# that proxies to it. One JSON object of label names to values; an installation
# that declares none cannot express the application's ingress and Serve refuses to
# apply the workload. It is not inferred from the installation's own Service names
# because pod labels are the installation's declaration.
OPL_WORKSPACE_APPLICATION_INGRESS_PEERS={"app.kubernetes.io/name":"<replace-with-serve-pod-name-label>","app.kubernetes.io/component":"serve"}

# The Fabric signed application-runtime boundary remains only for the provider
# whose in-process executor has not moved yet. An installation that declares both
# OPL_K8S_NAMESPACE and OPL_FABRIC_APPLICATION_URL has two writers for one workload
# and is refused at startup.
OPL_FABRIC_APPLICATION_URL=
OPL_FABRIC_SERVE_SERVICE_TOKEN=<replace-with-independent-fabric-serve-service-32-plus-random-chars>
OPL_FABRIC_SERVE_CAPABILITY_KEY=<replace-with-independent-fabric-serve-capability-32-plus-random-chars>
OPL_LEDGER_TOKEN=<replace-with-independent-ledger-32-plus-random-chars>

# Ledger (receipts, evidence, opaque provenance).
OPL_LEDGER_PEER_TOKENS={"workspace":"<32-plus-random-chars>","fabric":"<32-plus-random-chars>","capability":"<32-plus-random-chars>"}
OPL_INTERNAL_SERVICE_TOKEN=<replace-with-independent-internal-service-32-plus-random-chars>

# Fabric (infrastructure resource mutation and readback only).
OPL_FABRIC_ADDR=<replace-with-fabric-listen-address>
OPL_FABRIC_TOKEN=<replace-with-independent-fabric-32-plus-random-chars>
OPL_FABRIC_DATABASE_URL=<replace-with-fabric-database-url>
OPL_FABRIC_DOCKER_BINARY=<absolute-in-container-docker-binary-path>
OPL_FABRIC_LOCAL_DOCKER_PROBE_IMAGE=<replace-with-local-docker-probe-image>
OPL_CODEX_MODEL=<replace-with-runtime-model-name>
OPL_CODEX_PROVIDER_NAME=<replace-with-runtime-provider-name>
OPL_CODEX_REASONING_EFFORT=<replace-with-runtime-reasoning-effort>

# Control Plane (migration source; also serves the Console bundle).
CONTROL_PLANE_ADDR=<replace-with-control-plane-listen-address>
PORT=<replace-with-control-plane-http-port>
FABRIC_URL=<replace-with-fabric-http-url>
FABRIC_ADDR=<replace-with-fabric-listen-address>
LEDGER_URL=<replace-with-ledger-http-url>
LEDGER_ADDR=<replace-with-ledger-listen-address>
OPL_CONSOLE_DIST_DIR=<absolute-in-container-console-bundle-directory>
OPL_CONSOLE_USERS_JSON=<replace-with-console-users-json>
OPL_PROVIDER_ACCEPTANCE_TOKEN=<replace-with-independent-provider-acceptance-32-plus-random-chars>
OPL_RELEASE_SHA=<replace-with-exact-product-sha>
