# Source-development environment. For a released server installation, start
# from deploy/portable/opl-cloud.env.example instead.
NODE_ENV=development
DATABASE_URL=
LEDGER_URL=http://127.0.0.1:8081
FABRIC_URL=http://127.0.0.1:8082
OPL_INTERNAL_SERVICE_TOKEN=
OPL_FABRIC_SERVICE_TOKEN=
OPL_LEDGER_SERVICE_TOKEN=
OPL_FABRIC_CAPABILITY_KEY=
OPL_LEDGER_CAPABILITY_KEY=

# Console BFF owner endpoints (Gateway owns the spendable wallet and model catalog).
OPL_RUNTIME_CONTROL_URL=
OPL_RUNTIME_CONTROL_TOKEN=
OPL_GATEWAY_URL=
OPL_GATEWAY_TOKEN=

# Sub2API is the only spendable-balance owner.
OPL_SUB2API_BASE_URL=
OPL_SUB2API_ADMIN_EMAIL=
OPL_SUB2API_ADMIN_PASSWORD=
OPL_SUB2API_REQUEST_TIMEOUT_MS=5000
OPL_MONTHLY_BILLING_WORKER_ENABLED=0
OPL_MONTHLY_BILLING_INTERVAL_MS=3600000
OPL_AIONUI_ADMIN_PASSWORD_SEED=
