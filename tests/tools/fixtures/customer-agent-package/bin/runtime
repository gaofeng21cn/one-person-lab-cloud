#!/usr/bin/env node
/*
 * The fixture customer agent.
 *
 * The probe convention is this fixture's own: the package is packaged with a
 * probe file, and the runtime answers with the content of that file. The
 * harness replaces the probe file with a nonce it minted for this run before
 * it uploads the package, so an answer that carries the nonce can only come
 * from this upload.
 *
 * The probe file sits next to this script's package root, so the runtime finds
 * it wherever the platform copies the package to.
 */
const { readFileSync } = require("node:fs");
const { createServer } = require("node:http");
const { dirname, resolve } = require("node:path");

const probePath = process.env.OPL_PROBE_FILE || resolve(__dirname, "..", "provenance", "probe.txt");
let probe = "";
try {
  probe = readFileSync(probePath, "utf8").trim();
} catch {
  probe = "";
}

const port = Number(process.env.PORT || 3000);
createServer((request, response) => {
  response.writeHead(200, { "content-type": "application/json" });
  response.end(JSON.stringify({
    ok: true,
    service: "customer-agent-fixture",
    path: request.url,
    probe,
  }));
}).listen(port, "0.0.0.0");
